.DS_Store
*.sqlite3
media/
staticfiles/
evidence/
.uv/

# Real source material and import output never enter Git.
# The repository is public; even were it private, real row-level data and the
# reports derived from it belong in local storage only (Stage-2A brief 3).
private-data/
import-input/
import-output/
#
# No workbook is ever committed, not even a synthetic one: the synthetic
# fixtures are generated by the tests that use them, so a checked-in .xlsx
# could only be a real one that arrived by accident.
*.xlsx
*.xlsm
*.xls

# Written into the image at build time; never a source file.
BUILD_STAMP
