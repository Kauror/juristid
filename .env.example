# Copy to .env for local development. This file contains no secrets and must
# stay that way: .env itself is gitignored and never committed.
#
# Real Koda, member or otherwise confidential data must not be used locally.
# It may only enter an environment that has passed the Secure Pilot Gate
# (docs/secure-pilot-gate.md).

# --- core ---------------------------------------------------------------
DJANGO_DEBUG=1
# Required whenever DJANGO_DEBUG is off. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LOG_LEVEL=INFO

# --- database (PostgreSQL 18 or later) ----------------------------------
POSTGRES_DB=juristid
POSTGRES_USER=juristid
POSTGRES_PASSWORD=juristid
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable
# DATABASE_URL, when set, overrides the POSTGRES_* values above.
DATABASE_URL=

# --- environment gates ---------------------------------------------------
# Synthetic local sign-in. Only valid together with DJANGO_DEBUG=1 and never
# together with REAL_DATA_ALLOWED=1; a system check enforces both rules.
DEV_LOGIN_ENABLED=1
# Set to 1 only in an environment that has passed the Secure Pilot Gate.
REAL_DATA_ALLOWED=0
APPLICATION_ENVIRONMENT=local
APPLICATION_REVISION=dev

# --- evidence storage ----------------------------------------------------
# Local filesystem in development; Azure Blob in the secure pilot and
# production (docs/adr/0003-document-lifecycle.md).
EVIDENCE_ROOT=./evidence
MAX_EVIDENCE_UPLOAD_BYTES=104857600

# --- transport security (production) -------------------------------------
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_BEHIND_TLS_PROXY=0
