# Juristid — synthetic rehearsal environment, TEMPLATE.
#
# Copy to /mnt/user/appdata/juristid-test/config/juristid.env on the server,
# fill in the two generated secrets, and `chmod 600` it. The real file never
# enters Git; this template carries placeholders only.
#
#   install -d -m 700 /mnt/user/appdata/juristid-test/config
#   cp .env.example /mnt/user/appdata/juristid-test/config/juristid.env
#   chmod 600 /mnt/user/appdata/juristid-test/config/juristid.env
#
# Generate the secrets without putting them in shell history or in a log:
#
#   openssl rand -base64 36     # POSTGRES_PASSWORD
#   openssl rand -base64 64     # DJANGO_SECRET_KEY

# ---------------------------------------------------------------------------
# Data safety. These two lines are the reason this environment is allowed to
# exist at all.
# ---------------------------------------------------------------------------

# Never 1 on this host. The Unraid server is not an approved Koda real-data
# environment; real departmental data requires the Secure Pilot Gate
# (docs/secure-pilot-gate.md). A system check refuses to start a process that
# combines this with DEBUG or with the development sign-in.
REAL_DATA_ALLOWED=0

# Synthetic sign-in, because Entra ID is not wired up yet. On its own this is
# not authentication: you pick a user from a list, with no password.
DEV_LOGIN_ENABLED=1

# A shared PIN in front of that list. Empty means no PIN, which is right for a
# laptop and for CI; this instance sets one because it is reachable from outside
# the LAN.
#
# A short PIN is a speed bump, not authentication, and it is only defensible
# because everything behind it is invented. Wrong attempts from one address are
# locked out, which is what stops four digits from being a few seconds of
# scripted guessing.
DEV_LOGIN_PIN=replace-me-with-a-pin
DEV_LOGIN_PIN_MAX_ATTEMPTS=5
DEV_LOGIN_PIN_LOCKOUT_SECONDS=300

# Required for DEV_LOGIN_ENABLED to be permitted at all (check juristid.E002).
# It also means Django serves tracebacks on error, which is the other reason
# this deployment must not be reachable from the internet unprotected.
DJANGO_DEBUG=1

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------

DJANGO_SECRET_KEY=replace-me-with-openssl-rand-base64-64
DJANGO_ALLOWED_HOSTS=192.168.1.133,localhost,127.0.0.1,[::1],web
DJANGO_CSRF_TRUSTED_ORIGINS=http://192.168.1.133:3020
# HTTP on a trusted LAN. This is a rehearsal convenience, not transport
# security, and it must be revisited before anything reaches a real network.
DJANGO_SECURE_SSL_REDIRECT=0

# ---------------------------------------------------------------------------
# Identity of the running build
# ---------------------------------------------------------------------------

APPLICATION_ENVIRONMENT=unraid-test
APPLICATION_STAGE=Stage 2A rehearsal
# The exact commit this container was built from. Set it at deploy time:
#   APPLICATION_REVISION=$(git rev-parse --short HEAD)
APPLICATION_REVISION=unknown

# ---------------------------------------------------------------------------
# PostgreSQL. The host is the Compose service name; the database is reachable
# only from this project's network and publishes no host port.
# ---------------------------------------------------------------------------

POSTGRES_DB=juristid
POSTGRES_USER=juristid
POSTGRES_PASSWORD=replace-me-with-openssl-rand-base64-36
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable
