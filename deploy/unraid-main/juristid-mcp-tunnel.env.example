# Juristid — the Secure MCP Tunnel client's environment (`mcp-tunnel`), TEMPLATE.
#
# docs/adr/0185, docs/mcp/OPERATIONS.md. Three values and nothing of
# Juristid's: no Django key, no database password, no gate password. The
# client carries ChatGPT's MCP requests from OpenAI to `mcp` and needs only to
# prove to OpenAI which tunnel it is serving.
#
# Copy to /mnt/user/appdata/juristid-main/config/juristid-mcp-tunnel.env on the
# server, make it root's and 600, and fill it in with an editor. The real file
# never enters Git.
#
#   install -m 600 -o root -g root deploy/unraid-main/juristid-mcp-tunnel.env.example /mnt/user/appdata/juristid-main/config/juristid-mcp-tunnel.env
#
# The MCP server address, the health listener and the log format are set on the
# service in deploy/unraid-main/compose.yml and are not repeated here.

# The runtime API key, from platform.openai.com → Settings → Organization →
# API keys, created as **Restricted** with Tunnels **Read** + **Use** and
# nothing else — never an admin key and never an "All permissions" key. It
# lets its holder serve this tunnel, so it is a secret: paste it in an editor,
# never on a command line, and never into a chat or a ticket.
CONTROL_PLANE_API_KEY=replace-me-with-the-restricted-runtime-key

# The tunnel's id, `tunnel_` and 32 hex characters, from Tunnels management
# (platform.openai.com/settings/organization/tunnels). Not a secret on its own
# — it names the tunnel; the key above is what lets a client serve it — but it
# is the same id the ChatGPT connector is created with, so check it there.
CONTROL_PLANE_TUNNEL_ID=tunnel_replace-me

# The public Juristid origin, https, exactly as JURISTID_PUBLIC_ORIGIN. The MCP
# server's protected-resource metadata names it as the authorization server,
# and the client refuses to follow metadata to an origin it was not told to
# trust (matched by scheme, host and port). Not a secret; here rather than in
# compose.yml because it is this host's hostname and the repository is public.
MCP_OAUTH_TRUSTED_ORIGINS=https://replace-me.example.com
