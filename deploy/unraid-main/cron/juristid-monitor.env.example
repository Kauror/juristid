# scripts/deploy/juristid-monitor.sh reads this file (KEY=value lines, never
# sourced). Copy to /mnt/user/appdata/juristid-main/config/monitor.env, root,
# mode 600. It holds no secret; it holds paths and thresholds.
MONITOR_PROJECT=juristid-main
MONITOR_COMPOSE_FILE=/mnt/user/appdata/juristid-main/repo/deploy/unraid-main/compose.yml
MONITOR_DATA_ROOT=/mnt/user/appdata/juristid-main
MONITOR_BACKUP_ROOT=/mnt/user/backups/juristid-main
MONITOR_HEALTHZ_URL=https://juristid.orgusaar.ee/healthz
MONITOR_DUMP_DIR=/mnt/user/backups/databases/juristid-main-db
MONITOR_SYNC_LOG_DIR=/mnt/user/appdata/juristid-main/l100/sync/logs
MONITOR_APPDATA_BACKUP_DIR=/mnt/user/Backups
# A dead-man's-switch URL (ping only, no data); leave empty for none.
MONITOR_HEARTBEAT_URL=
# 1 while the mcp profile is meant to be running (docs/mcp/OPERATIONS.md,
# "Switching off" sets it back to 0 together with the switch).
MONITOR_MCP_PROFILE_ON=1
# The RPO: a decision, no default (docs/open-decisions.md). Required for --tier daily.
MONITOR_RPO_HOURS=
# Thresholds the 2026-10-29 review proposed; tune after a week of reading them.
MONITOR_FREE_GIB_WARN=20
MONITOR_FREE_GIB_CRIT=5
MONITOR_ERRORS_WARN=0
MONITOR_GATE_FAIL_WARN=20
MONITOR_LOCKED_OUT_WARN=3
MONITOR_STEP_UP_FAIL_WARN=3
