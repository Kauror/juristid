# Juristid — real-data environment, TEMPLATE.
#
# Copy to /mnt/user/appdata/juristid-main/config/juristid.env on the server,
# fill in the generated secrets, and `chmod 600` it. The real file never enters
# Git; this template carries placeholders only.
#
#   install -d -m 700 /mnt/user/appdata/juristid-main/config
#   cp .env.example /mnt/user/appdata/juristid-main/config/juristid.env
#   chmod 600 /mnt/user/appdata/juristid-main/config/juristid.env
#
# Generate the secrets without putting them in shell history or in a log:
#
#   openssl rand -base64 36     # POSTGRES_PASSWORD
#   openssl rand -base64 64     # DJANGO_SECRET_KEY

# ---------------------------------------------------------------------------
# Data safety. This is the environment that is allowed to hold the real thing,
# and the four lines below are why.
# ---------------------------------------------------------------------------

# The Chamber's own register and member material. Everything else here exists
# to make this line safe: an authenticator in front, no debug output, no
# passwordless sign-in, and no host port to walk around the front door with.
REAL_DATA_ALLOWED=1

# Never 1 here. The synthetic sign-in is a list of users with no password, and
# a system check refuses to start a process that combines it with real data or
# with any real authenticator (juristid.E003, juristid.E008).
DEV_LOGIN_ENABLED=0

# Never 1 here. Debug serves tracebacks — including query fragments and file
# paths — to whoever triggered the error (juristid.E004).
DJANGO_DEBUG=0

# ---------------------------------------------------------------------------
# Authentication mode
#
#   shared_gate        one department password, then a persona from a list
#   cloudflare_access  Cloudflare verifies the individual; we verify Cloudflare
#
# Business authorization is identical in both. What differs is how much this
# deployment may claim about the identity behind a request — and every audit row
# records which of the two it was (docs/adr/0016).
# ---------------------------------------------------------------------------

AUTH_MODE=shared_gate

# -- the shared gate --------------------------------------------------------
#
# TEMPORARY, and named honestly. One password for the whole department: it
# authenticates the *door*, not the person. After it, somebody picks whose work
# they are looking at, and that selection is a choice rather than a proof.
#
# This is not the old four-digit PIN, and the difference is not just length:
# the PIN was explicitly forbidden with real data, this mode is a distinct
# authenticator with its own safeguards, and `manage.py check` refuses to start
# without them (juristid.E010 through E013).
#
# The password is a HOST-SIDE SECRET. It exists in this file and nowhere else:
# not in Git, not in a Compose default, not in the image, not in CI, not in a
# log, and not in anything the browser receives.
#
# Generate one and keep it long — 12 characters is the floor the check enforces,
# and the floor is not the target:
#
#   openssl rand -base64 24
JURISTID_SHARED_GATE_PASSWORD=replace-me-with-a-long-generated-password

# Wrong attempts from one client before it is locked out, the first lockout's
# length, and the ceiling that stops escalation from becoming permanent. Each
# cycle doubles the wait, capped: an attacker slows to a standstill while
# somebody who mistyped twice waits five minutes once.
#
# Per client, never global — a global counter would let one attacker lock the
# department out of its own system.
SHARED_GATE_MAX_ATTEMPTS=5
SHARED_GATE_LOCKOUT_SECONDS=300
SHARED_GATE_MAX_LOCKOUT_SECONDS=3600

# How long a session lasts before the password is asked for again.
SHARED_GATE_SESSION_SECONDS=43200

# -- Cloudflare Access (the next step, not this one) ------------------------
#
# When the Access application exists, switch AUTH_MODE to cloudflare_access and
# fill these in; nothing else about the deployment changes. The audience tag
# identifies *this* application inside the Cloudflare account — without it a
# token minted for any other application on the same team would verify here,
# which is why an unconfigured cloudflare_access mode refuses every request
# rather than defaulting to something permissive (juristid.E007).
#
# There is no separate on/off switch. Access is on exactly when AUTH_MODE says
# so; two switches for one decision is how a deployment ends up with an
# authenticator that is configured and not running.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUDIENCE=

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------

DJANGO_SECRET_KEY=replace-me-with-openssl-rand-base64-64
# The tunnel's hostname and the compose service name. No LAN address: there is
# no host port to reach one on.
DJANGO_ALLOWED_HOSTS=replace-me.example.com,web
DJANGO_CSRF_TRUSTED_ORIGINS=https://replace-me.example.com
# Cloudflare terminates TLS and the tunnel speaks HTTP to the container, so the
# redirect belongs at the edge rather than here — turning it on would loop.
# The session cookie is still Secure-only, which a system check enforces
# whenever the shared gate is on (juristid.E013).
DJANGO_SECURE_SSL_REDIRECT=0

# ---------------------------------------------------------------------------
# Identity of the running build
# ---------------------------------------------------------------------------

APPLICATION_ENVIRONMENT=unraid-main
APPLICATION_STAGE=Stage 2D
# The exact commit this container was built from. Set it at deploy time:
#   APPLICATION_REVISION=$(git rev-parse --short HEAD)
APPLICATION_REVISION=unknown

# ---------------------------------------------------------------------------
# PostgreSQL. The host is the Compose service name; the database is reachable
# only from this project's network and publishes no host port.
# ---------------------------------------------------------------------------

POSTGRES_DB=juristid
POSTGRES_USER=juristid
POSTGRES_PASSWORD=replace-me-with-openssl-rand-base64-36
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable

# ---------------------------------------------------------------------------
# The historical corpus.
#
# Mounted read-only into both application containers. The importer reads the
# register, the OneNote archive and the migration audit from here and never
# writes back (Stage-2D brief 54). The conventional layout under this root is:
#
#   excel/Tööd eelnõudega.xlsx
#   onenote-desktop-archive/
#   migration-audit/
#
# so that an operator types a phase name and nothing else. A long path retyped
# at 2am is a path that ends up pointing at the wrong archive.
# ---------------------------------------------------------------------------

HISTORICAL_SOURCE_ROOT=/srv/historical-source
