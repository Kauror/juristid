# Juristid — the MCP server's environment (`mcp` service), TEMPLATE.
#
# docs/adr/0185, docs/mcp/OPERATIONS.md. The read-only MCP server that answers
# ChatGPT runs from the release image with THIS file — not juristid.env. That
# file holds the shared-gate password, the MFA key and the mail credentials,
# and this process needs none of them: it verifies bearer tokens by their
# SHA-256 digest and reads the register as the person who connected. What a
# process is not given it cannot leak (ADR 0179).
#
# Copy to /mnt/user/appdata/juristid-main/config/juristid-mcp.env on the
# server, fill it in, and make it root's and 600. The real file never enters
# Git; this template carries placeholders only, and every `replace-me…` value
# left in it stops the process (juristid.E016).
#
#   install -m 600 -o root -g root deploy/unraid-main/juristid-mcp.env.example /mnt/user/appdata/juristid-main/config/juristid-mcp.env
#
# Then edit it in place. Generate the one new secret without printing it — the
# command writes it into the file, so it reaches neither the terminal nor the
# shell history:
#
#   sed -i "s|^DJANGO_SECRET_KEY=.*|DJANGO_SECRET_KEY=$(openssl rand -base64 64 | tr -d '\n/+=')|" /mnt/user/appdata/juristid-main/config/juristid-mcp.env
#
# Not repeated here, because Compose sets them on the service itself
# (deploy/unraid-main/compose.yml): the database host `db`, its port and SSL
# mode, the process role `mcp`, the deployed-runtime marker, the listen
# address and port, and SEED_DEV_DATA.

# ---------------------------------------------------------------------------
# Data safety
# ---------------------------------------------------------------------------

# The register is real here, as in juristid.env.
REAL_DATA_ALLOWED=1

# The deployment's authentication mode, named because real data with no mode
# is refused (juristid.E006). In the `mcp` role it is a statement about the
# deployment, not a door this process opens: it serves no gate, so the gate
# password is deliberately NOT in this file — and must never be added. The
# process refuses to start holding it, the MFA key or the mail password
# (juristid.E046).
AUTH_MODE=shared_gate

# Debug and the synthetic sign-in are off by their defaults and are not
# named here at all; a debug MCP process is refused (juristid.E044).

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------

# Its OWN signing key, deliberately not web's. This process issues nothing a
# browser presents back — no session, no CSRF token, no signed link — and
# tokens are looked up by SHA-256, so a distinct value costs nothing and means
# a leak from this container does not let anybody forge a web session. At
# least 50 characters on real data (juristid.E017).
#
# TODO(integrator, workstream C): correct only while token digests are plain
# SHA-256 (CONTRACT.md "C → B"). If verification ever keys a digest or a
# signature on SECRET_KEY, this must become web's value — and the reasoning
# above changes with it.
DJANGO_SECRET_KEY=replace-me-with-openssl-rand-base64-64

# Optional. INFO by default; the MCP server logs calls by tool and outcome,
# never their text.
# DJANGO_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# PostgreSQL — the same database as juristid.env, under a role of its own.
#
# `juristid_mcp` holds SELECT and nothing else (MCPSEC-03): no INSERT, UPDATE,
# DELETE, TRUNCATE or CREATE anywhere, no membership of the owner role, no
# access to django_session. JURISTID_PROCESS_ROLE=mcp also opens every
# connection with default_transaction_read_only=on — the second lock; the
# role's privileges are the one no code in this process can switch off. The
# process refuses to start on real data under any other kind of role
# (juristid.E047).
#
# The password is this file's own, never juristid.env's. Generate it straight
# into this file, then create the role from `web`, which reads it from here on
# stdin (docs/mcp/OPERATIONS.md, first-time enablement step 2):
#   the `sed -i "s|^POSTGRES_PASSWORD=.*|…|"` line in that step.
# Rotating it is the same two steps, then recreating `mcp`.
# ---------------------------------------------------------------------------

POSTGRES_DB=juristid
POSTGRES_USER=juristid_mcp
POSTGRES_PASSWORD=replace-me-with-openssl-rand-base64-48

# ---------------------------------------------------------------------------
# MCP (docs/adr/0185)
# ---------------------------------------------------------------------------

# Required in this role: with it off the process refuses to start.
MCP_ENABLED=1

# The origin colleagues open Juristid at, https. Every link the tools return
# and the OAuth issuer the metadata names are built from it — never from a
# request's Host header. The same value as in juristid.env.
JURISTID_PUBLIC_ORIGIN=https://replace-me.example.com

# The resource (audience) values a token may be issued for and is accepted at,
# comma-separated, https, no trailing slash. For the Secure MCP Tunnel that is
# the OpenAI-hosted tunnel MCP endpoint, `/v1/mcp/<tunnel id>` — the URL OpenAI
# rewrites discovery to. The same value as in juristid.env: `web` issues the
# token, this process accepts it, and both compare against this list.
#
# TODO(integrator, first enablement): confirm the exact host OpenAI uses for
# the tunnel endpoint when the connector is created (docs/mcp/OPERATIONS.md,
# "Connecting ChatGPT"); a token for any other resource is refused with 401.
MCP_RESOURCE_URLS=https://api.openai.com/v1/mcp/tunnel_replace-me

# Optional. The Host headers the transport accepts. Unset, the default is the
# hosts of MCP_RESOURCE_URLS plus mcp, mcp:<port>, localhost and 127.0.0.1 —
# which covers what the tunnel client sends (MCP_SERVER_URL is
# http://mcp:8001/mcp). Set it only if the `mcp` log refuses a Host the
# default does not fit.
# MCP_ALLOWED_HOSTS=mcp,mcp:8001,localhost,127.0.0.1

# Optional. The Origin headers accepted when a request carries one. Unset, the
# origins of MCP_RESOURCE_URLS and JURISTID_PUBLIC_ORIGIN plus
# https://chatgpt.com. A server-to-server client sends none.
# MCP_ALLOWED_ORIGINS=https://chatgpt.com

# ---------------------------------------------------------------------------
# MCP writes (docs/adr/0189): the write tools, forwarded to `mcp-writer`
#
# This process still never writes: its role stays SELECT-only and its
# connections read-only. With writes on it lists the prepare_* and
# commit_prepared_action tools and forwards each call — the person's own
# bearer token, verbatim — to the write gateway over the internal `mcp_write`
# network. OFF until the gateway runs and is healthy (docs/mcp/OPERATIONS.md,
# Phase 2). The writer's database credentials are NEVER in this file
# (juristid.E058).
# ---------------------------------------------------------------------------

MCP_WRITES_ENABLED=0

# The gateway key, the one new secret this process holds: EXACTLY the value in
# juristid-mcp-writer.env, at least 32 characters once MCP_WRITES_ENABLED=1
# (juristid.E052). Generated into both files, never printed, by
# scripts/deploy/juristid-mcp-writer-keys.sh.
MCP_WRITE_GATEWAY_KEY=replace-me-with-openssl-rand-base64-48

# Where the gateway is. Set on the service by compose.yml
# (http://mcp-writer:8002), which wins over this file; named here only so the
# template lists every write setting.
# MCP_WRITE_GATEWAY_URL=http://mcp-writer:8002

# Optional limits; the defaults in config/settings.py are the decided ones.
# MCP_MAX_CONCURRENT_CALLS=4
# MCP_CALL_TIMEOUT_SECONDS=60
# MCP_FETCH_MAX_CHARS=20000
# MCP_MAX_REQUEST_BYTES=65536
