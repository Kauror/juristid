# Juristid — the MCP write gateway's environment (`mcp-writer` service), TEMPLATE.
#
# docs/adr/0189, docs/mcp/OPERATIONS.md ("Phase 2: AI writes"). The write
# gateway executes a change an AI client prepared, and only after the person
# approved it on Juristid's own page with their own authenticator. It runs
# from the release image with THIS file — never juristid.env (the shared-gate
# password, the MFA key, the MCP authenticator and derivation keys, the mail
# credentials: it needs none of them and refuses to start holding one,
# juristid.E056) and never juristid-mcp.env (`mcp`'s read-only database role
# is not its own).
#
# Copy to /mnt/user/appdata/juristid-main/config/juristid-mcp-writer.env on the
# server, make it root's and 600, and fill it in. The real file never enters
# Git; every `replace-me…` value left in it stops the process (juristid.E016).
#
#   install -m 600 -o root -g root deploy/unraid-main/juristid-mcp-writer.env.example /mnt/user/appdata/juristid-main/config/juristid-mcp-writer.env
#
# The three secrets are generated straight into the files, never printed —
# this file's signing key and database password, and the gateway key it shares
# with juristid-mcp.env:
#
#   scripts/deploy/juristid-mcp-writer-keys.sh \
#     --writer-env-file /mnt/user/appdata/juristid-main/config/juristid-mcp-writer.env \
#     --mcp-env-file /mnt/user/appdata/juristid-main/config/juristid-mcp.env
#
# Not repeated here, because Compose sets them on the service itself
# (deploy/unraid-main/compose.yml): the database host `db`, its port and SSL
# mode, the process role `mcp_writer`, the deployed-runtime marker, the listen
# address and port, and SEED_DEV_DATA.

# ---------------------------------------------------------------------------
# Data safety
# ---------------------------------------------------------------------------

REAL_DATA_ALLOWED=1

# A statement about the deployment, as in juristid-mcp.env: this process
# serves no gate, and the gate password is deliberately NOT in this file.
AUTH_MODE=shared_gate

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------

# Its OWN signing key — not web's and not mcp's. The gateway signs nothing a
# browser presents back, and tokens are looked up by SHA-256. At least 50
# characters on real data (juristid.E017).
#
# TODO(integrator, workstream C): correct only while nothing the gateway
# produces is signed with SECRET_KEY and checked by `web` (approval links are
# plain URLs carrying the proposal's UUID). If that ever changes, this must
# become web's value.
DJANGO_SECRET_KEY=replace-me-with-openssl-rand-base64-64

# DJANGO_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# PostgreSQL — the same database, under the writer's own role.
#
# `juristid_mcp_writer` (app/mcp_writes/db_role.py): SELECT on the schema except
# django_session; INSERT/UPDATE (DELETE on the search projection only) on the
# tables the approved operations' canonical services write, and on the
# gateway's own proposal and event tables; NO write on accounts, MCP grants,
# tokens, authenticators or approvals, no TRUNCATE, no DDL, member of nothing,
# owner of nothing. The process refuses to start on real data under any other
# kind of role (juristid.E050).
#
# Create it from `web` after the release's migrations, reading the password
# from this file on stdin (docs/mcp/OPERATIONS.md, Phase 2 step 3):
#   sed -n 's/^POSTGRES_PASSWORD=//p' <this file> | docker compose … exec -T web \
#     python manage.py mcp_writer_db_role --apply --password-stdin
# ---------------------------------------------------------------------------

POSTGRES_DB=juristid
POSTGRES_USER=juristid_mcp_writer
POSTGRES_PASSWORD=replace-me-with-openssl-rand-base64-48

# ---------------------------------------------------------------------------
# MCP (docs/adr/0185) — the gateway verifies the forwarded bearer token itself
# ---------------------------------------------------------------------------

# Required: token verification answers nothing while MCP access is off
# (juristid.E054). The same three values as in juristid-mcp.env.
MCP_ENABLED=1
JURISTID_PUBLIC_ORIGIN=https://replace-me.example.com
MCP_RESOURCE_URLS=https://api.openai.com/v1/mcp/tunnel_replace-me

# ---------------------------------------------------------------------------
# MCP writes (docs/adr/0189)
# ---------------------------------------------------------------------------

# Required in this role: with it off the process refuses to start
# (juristid.E051). The switch for AI writes is whether this service runs, and
# MCP_WRITES_ENABLED on `web` and `mcp`; stopping `mcp-writer` disables every
# AI write while reading continues.
MCP_WRITES_ENABLED=1

# The key `mcp` presents on every call (constant-time compared). It proves the
# caller is the `mcp` container and nothing more: every request is still
# authorized by the person's own bearer token, which this process verifies.
# At least 32 characters (juristid.E052); EXACTLY the value in juristid-mcp.env;
# never in juristid.env (juristid.E057). Generated by
# scripts/deploy/juristid-mcp-writer-keys.sh.
MCP_WRITE_GATEWAY_KEY=replace-me-with-openssl-rand-base64-48

# Optional limits; the defaults in config/settings.py are the decided ones.
# MCP_WRITE_MAX_CONCURRENT_CALLS=2
# MCP_WRITE_CALL_TIMEOUT_SECONDS=30
# MCP_WRITE_MAX_REQUEST_BYTES=65536
# MCP_WRITE_PROPOSAL_SECONDS=900
# MCP_WRITE_APPROVAL_SECONDS=600
# MCP_WRITE_MAX_TEXT_CHARS=8000
