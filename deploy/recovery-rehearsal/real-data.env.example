# Juristid — real-data RECOVERY REHEARSAL environment, TEMPLATE.
#
# FOR ISOLATED RECOVERY REHEARSAL ONLY. This is the environment for
# `compose.real-data.yml`, not for a deployment. It never becomes
# `/mnt/user/appdata/juristid-main/config/juristid.env`.
#
# ============================================================================
# DO NOT COPY PRODUCTION'S ENVIRONMENT FILE INTO A REHEARSAL.
# ============================================================================
#
# The temptation is obvious — the stack holds production's data, so why not
# production's settings — and it is wrong twice. It spreads the real
# `DJANGO_SECRET_KEY` and the real shared-gate password onto a scratch disk that
# is about to be handled casually and deleted; and it proves nothing, because a
# restored cluster is a *new* cluster whose superuser password is whatever this
# file says it is. Production's password would not even be the right one.
#
# So: generate throwaway values, on the host, into a file you delete with the
# rehearsal. Nobody signs in to this stack.
#
#   umask 177
#   cp real-data.env.example /path/to/scratch/config/rehearsal.env
#   openssl rand -base64 36     # POSTGRES_PASSWORD
#   openssl rand -base64 64     # DJANGO_SECRET_KEY
#   openssl rand -base64 30     # JURISTID_SHARED_GATE_PASSWORD
#
# Generating them on the host keeps them out of your shell history on another
# machine, out of any transcript, and out of this repository.

# ---------------------------------------------------------------------------
# Data safety. A rehearsal holds the real register, so the same four lines that
# make production safe apply here — with no route in at all instead of a tunnel.
# ---------------------------------------------------------------------------

# The restored set is the Chamber's own material.
REAL_DATA_ALLOWED=1

# Never 1. A system check refuses to combine the passwordless sign-in with real
# data (juristid.E003, juristid.E008), and a rehearsal is not an exception.
DEV_LOGIN_ENABLED=0

# Never 1. Debug output renders settings and query values into a traceback.
DJANGO_DEBUG=0

# Never seeded over a restore. The seed writes rows, and rows written after a
# restore are rows that did not come out of the backup set.
SEED_DEV_DATA=0

# ---------------------------------------------------------------------------
# Authentication. Configured, and then not used: the stack publishes no port and
# its network is internal, so there is nothing to authenticate to. It is set
# because `deployment_readiness` reports the authenticator, and a rehearsal that
# reported "no auth mode" would be reporting something production never is.
# ---------------------------------------------------------------------------

AUTH_MODE=shared_gate
JURISTID_SHARED_GATE_PASSWORD=replace-me-with-a-generated-throwaway-password
SHARED_GATE_MAX_ATTEMPTS=5
SHARED_GATE_LOCKOUT_SECONDS=300
SHARED_GATE_MAX_LOCKOUT_SECONDS=3600
SHARED_GATE_SESSION_SECONDS=43200

CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUDIENCE=

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------

DJANGO_SECRET_KEY=replace-me-with-openssl-rand-base64-64

# No real hostname. Nothing resolves here and nothing should: the container
# names below are what a one-off `run --rm` uses.
DJANGO_ALLOWED_HOSTS=juristid-recovery-rehearsal-real-web,web,localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=https://rehearsal.invalid
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_BEHIND_TLS_PROXY=1

# Production's value on purpose. `deployment_readiness` reports the environment,
# and a rehearsal is asking whether *production's* configuration comes back.
APPLICATION_ENVIRONMENT=unraid-main

# ---------------------------------------------------------------------------
# PostgreSQL. A new, disposable cluster: this password is created by the
# rehearsal, not recovered by it. The dump does not carry one.
# ---------------------------------------------------------------------------

POSTGRES_DB=juristid
POSTGRES_USER=juristid
POSTGRES_PASSWORD=replace-me-with-openssl-rand-base64-36
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable

# HISTORICAL_SOURCE_ROOT is deliberately absent. The source corpus is not in a
# backup set; mount it, read-only, by adding `compose.real-data.source.yml` when
# a rehearsal genuinely needs it.
